# 复制为 .env 后填写实际值
# cp .env.example .env

# 必填：模型 API Key
PCC_API_KEY=sk-your-key-here

# 必填：图库根目录
PCC_GALLERY=/Volumes/新加卷/3d建模

# 可选：OpenAI 兼容端点
# PCC_API_BASE=https://your-endpoint.example.com/v1

# 可选：模型名
# PCC_VL_MODEL=qwen3-vl-plus
# PCC_IMG_MODEL=qwen-image-2.1-pro

# 可选：网页版端口
# PCC_PORT=8125

# 可选：输出目录（外置卷不可用时的回退位置）
# PCC_LOCAL_OUT=~/WorkBuddy/dt-output
